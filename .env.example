# Contoh/referensi environment variables untuk UPterindo.
# File ini TIDAK otomatis dibaca oleh server (tidak memakai paket "dotenv"),
# jadi untuk pengembangan lokal isi nilainya langsung di shell sebelum
# menjalankan `npm start`, atau isi di panel Environment Variables platform
# hosting untuk produksi. Jangan commit file ".env" berisi nilai asli.

PORT=3000
ADMIN_INITIAL_PASSWORD=
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
