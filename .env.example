# Salin file ini jadi ".env" untuk pengembangan lokal, atau isi langsung di
# panel Environment Variables platform hosting (Hostinger dkk) untuk produksi.
# JANGAN commit file ".env" yang sudah diisi nilai asli — sudah masuk .gitignore.

PORT=3000

# WAJIB diganti ke nilai acak rahasia sebelum dipakai sungguhan di produksi.
# Cara membuat nilainya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-nilai-acak-anda-sendiri

# SMTP (opsional) — supaya notifikasi email pendaftaran akun baru benar-benar
# terkirim. Kalau SMTP_USER/SMTP_PASS kosong, email masuk mode simulasi
# (hanya dicatat ke log server, aplikasi tetap berjalan normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Alamat yang menerima notifikasi pendaftaran akun baru.
ADMIN_NOTIFY_EMAIL=arifinbuburanda@gmail.com

# OpenAI (opsional) — untuk analisis foto tanaman sungguhan. Kalau kosong,
# fitur ini otomatis memakai contoh hasil simulasi.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
